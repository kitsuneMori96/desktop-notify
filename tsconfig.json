{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "node",
      "bun"
    ],
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "sourceMap": false,
    "strict": false,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false
  },
  "include": [
    "desktop-notify.ts"
  ]
}